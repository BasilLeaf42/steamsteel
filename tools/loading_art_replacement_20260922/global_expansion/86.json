print\" typeof=\"mw:File/Frameless\"><a href=\"https://www.wikidata.org/wiki/Q170209#P570\" title=\"Edit this at Wikidata\"><img alt=\"Edit this at Wikidata\" src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/OOjs_UI_icon_edit-ltr-progressive.svg/20px-OOjs_UI_icon_edit-ltr-progressive.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"10\" height=\"10\" class=\"mw-file-element\" data-file-width=\"20\" data-file-height=\"20\"></a></span></td></tr>\n<tr>\n<th scope=\"row\">Location of birth/death</th>\n<td class=\"halfwidth\" id=\"fileinfotpl_creator_birthloc_value\">\n<a href=\"https://en.wikipedia.org/wiki/en:Catania\" class=\"extiw\" title=\"w:en:Catania\"><span title=\"city in Sicily, Italy\">Catania</span></a>, <a href=\"https://en.wikipedia.org/wiki/en:Category:Kingdom_of_Naples\" class=\"extiw\" title=\"w:en:Category:Kingdom of Naples\"><span title=\"Wikimedia category\">Category:Kingdom of Naples</span></a></td><td class=\"halfwidth\" id=\"fileinfotpl_creator_deathloc_value\">\n<a href=\"https://en.wikipedia.org/wiki/en:Puteaux\" class=\"extiw\" title=\"w:en:Puteaux\"><span title=\"commune in Hauts-de-Seine, France\">Puteaux</span></a>, <a href=\"https://en.wikipedia.org/wiki/en:France\" class=\"extiw\" title=\"w:en:France\"><span title=\"country in Western Europe and other continents (through its overseas territories in America, Africa and Oceania)\">France</span></a></td></tr>\n<tr>\n<th scope=\"row\">Work period</th>\n<td colspan=\"2\" class=\"fullwidth\" id=\"fileinfotpl_creator_work-period_value\">1825-1835</td></tr>\n<tr>\n<th scope=\"row\">Work location</th>\n<td colspan=\"2\" class=\"fullwidth\" id=\"fileinfotpl_creator_work-location\"><div class=\"locality\">\n<a href=\"https://en.wikipedia.org/wiki/en:Naples\" class=\"extiw\" title=\"w:en:Naples\"><span title=\"capital city of Campania, Italy\">Naples</span></a>, <a href=\"https://en.wikipedia.org/wiki/