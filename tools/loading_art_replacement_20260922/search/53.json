            "Artist": {
              "value": "<div class=\"fn value\">\n<a rel=\"nofollow\" class=\"external free\" href=\"http://www.geographicus.com/mm5/cartographers/classon.txt\">http://www.geographicus.com/mm5/cartographers/classon.txt</a></div>",
              "source": "commons-desc-page"
